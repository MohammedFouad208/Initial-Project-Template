@model AdminTemplate.Web.ViewModels.RolePermissions.RolePermissionsViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["RolePermissions_Index_Title"];

    var allFunctions = Model.AllObjects
        .SelectMany(o => o.Functions)
        .Distinct()
        .ToList();
}

<style>
    .permission-matrix td:first-child,
    .permission-matrix th:first-child {
        position: sticky;
        inset-inline-start: 0;
        background: var(--bg-card);
        z-index: 1;
        border-inline-end: 2px solid var(--border-color);
        min-width: 200px;
    }
    .permission-matrix th { white-space: nowrap; text-align: center; vertical-align: middle; }
    .permission-matrix td { text-align: center; vertical-align: middle; }
    .permission-matrix td:first-child { text-align: start; }
    .col-toggle-label { display: block; font-size: 0.75rem; color: var(--text-muted); margin-block-start: 0.25rem; }
</style>

<div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-3">
    <div>
        <h1 class="mb-1">@string.Format(Localizer["RolePermissions_Index_Heading"], Model.RoleName)</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none breadcrumb-link">@Localizer["Common_Home"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Roles" asp-action="Index" class="text-decoration-none breadcrumb-link">@Localizer["Roles_Index_Title"]</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">@Localizer["RolePermissions_Index_Title"]</li>
            </ol>
        </nav>
    </div>
</div>

@if (TempData["ToastMessage"] != null)
{
    var toastType = TempData["ToastType"]?.ToString() == "danger" ? "danger" : "success";
    var icon = toastType == "danger" ? "fa-circle-xmark" : "fa-circle-check";
    <div class="alert alert-@toastType alert-dismissible fade show" role="alert"
         style="border-inline-start:4px solid var(--@toastType)">
        <i class="fa-solid @icon me-2"></i>@TempData["ToastMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post" asp-action="Save">
    @Html.AntiForgeryToken()
    <input type="hidden" name="roleId" value="@Model.RoleId" />

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered permission-matrix mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">@Localizer["RolePermissions_Column_ObjectFunction"]</th>
                            @foreach (var func in allFunctions)
                            {
                                <th scope="col">
                                    @func
                                    <label class="col-toggle-label">
                                        <input type="checkbox" class="form-check-input col-toggle" data-func="@func" title="Toggle @func column" />
                                        <span class="visually-hidden">Toggle all @func</span>
                                    </label>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var obj in Model.AllObjects)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="fw-medium">@obj.DisplayName</span>
                                        <button type="button" class="btn btn-outline-secondary btn-sm check-all-btn" data-object="@obj.Name">All</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm check-none-btn" data-object="@obj.Name">None</button>
                                    </div>
                                </td>
                                @foreach (var func in allFunctions)
                                {
                                    var isSupported = obj.Functions.Contains(func);
                                    var isChecked   = Model.AssignedKeys.Contains($"{obj.Name}|{func}");
                                    <td>
                                        @if (isSupported)
                                        {
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   name="selectedPermissions"
                                                   value="@obj.Name|@func"
                                                   data-object="@obj.Name"
                                                   data-func="@func"
                                                   @(isChecked ? "checked" : "") />
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary btn-md">
            <i class="fa-solid fa-floppy-disk me-1"></i>@Localizer["RolePermissions_Label_SavePermissions"]
        </button>
        <a asp-controller="Roles" asp-action="Index" class="btn btn-outline-secondary btn-md ms-2">
            <i class="fa-solid fa-arrow-left me-1"></i>@Localizer["RolePermissions_Label_BackToRoles"]
        </a>
    </div>
</form>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
(function () {
    document.querySelectorAll('.check-all-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var obj = btn.getAttribute('data-object');
            document.querySelectorAll('input[type="checkbox"][data-object="' + obj + '"]')
                .forEach(function (cb) { cb.checked = true; });
        });
    });
    document.querySelectorAll('.check-none-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var obj = btn.getAttribute('data-object');
            document.querySelectorAll('input[type="checkbox"][data-object="' + obj + '"]')
                .forEach(function (cb) { cb.checked = false; });
        });
    });
    document.querySelectorAll('.col-toggle').forEach(function (toggle) {
        toggle.addEventListener('change', function () {
            var func    = toggle.getAttribute('data-func');
            var checked = toggle.checked;
            document.querySelectorAll('tbody input[type="checkbox"][data-func="' + func + '"]')
                .forEach(function (cb) { cb.checked = checked; });
        });
    });
})();
</script>
}
