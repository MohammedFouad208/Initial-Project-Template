@model AdminTemplate.Web.ViewModels.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Localizer["Login_Title"];
}

<h2 class="auth-title">@Localizer["Login_Heading"]</h2>
<p class="auth-subtitle">@Localizer["Login_Subtitle"]</p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="fa-solid fa-circle-check flex-shrink-0"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<form asp-action="Login" method="post" novalidate>
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mb-4" role="alert">
            <div class="d-flex align-items-start gap-2">
                <i class="fa-solid fa-circle-exclamation flex-shrink-0 mt-1"></i>
                <div asp-validation-summary="All"></div>
            </div>
        </div>
    }

    <div class="mb-4">
        <label asp-for="Email" class="form-label">@Localizer["Common_Email"]</label>
        <div class="field-icon-wrap">
            <i class="fa-regular fa-envelope field-icon"></i>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="text-danger d-block mt-1" style="font-size:0.8125rem"></span>
    </div>

    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label asp-for="Password" class="form-label mb-0">@Localizer["Common_Password"]</label>
            <a asp-action="ForgotPassword" asp-controller="Account"
               class="text-decoration-none"
               style="font-size:0.8125rem;color:var(--primary)">@Localizer["Login_ForgotPassword"]</a>
        </div>
        <div class="field-icon-wrap">
            <i class="fa-solid fa-lock field-icon"></i>
            <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
        </div>
        <span asp-validation-for="Password" class="text-danger d-block mt-1" style="font-size:0.8125rem"></span>
    </div>

    <div class="mb-4">
        <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label" style="font-size:0.875rem">
                @Localizer["Login_RememberMe"]
            </label>
        </div>
    </div>

    <div class="d-grid mb-2">
        <button type="submit" class="btn btn-primary btn-sm">
            <span class="btn-text">
                @Localizer["Login_SignInButton"] &nbsp;<i class="fa-solid fa-arrow-right-to-bracket"></i>
            </span>
        </button>
    </div>

</form>

<div class="auth-footer-link">
    @Localizer["Login_NoAccount"]
    <a asp-action="Register" asp-controller="Account">@Localizer["Login_CreateOne"]</a>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
