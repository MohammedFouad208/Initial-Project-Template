@model AdminTemplate.Web.ViewModels.ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
}

<div class="text-center mb-3">
    <h2 class="auth-header">AdminTemplate</h2>
    <p class="text-muted">Forgot your password?</p>
</div>

<p class="text-muted small mb-3">Enter your registered email address and we will send you a reset link.</p>

<form asp-action="ForgotPassword" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="alert alert-danger" role="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="d-grid">
        <button type="submit" class="btn btn-primary">Send Reset Link</button>
    </div>

    <div class="mt-3 text-center">
        <a asp-action="Login" asp-controller="Account">Back to Sign In</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
