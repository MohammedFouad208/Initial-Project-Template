@model AdminTemplate.Web.ViewModels.ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Localizer["ForgotPassword_Title"];
}

<h2 class="auth-title">@Localizer["ForgotPassword_Heading"]</h2>
<p class="auth-subtitle">@Localizer["ForgotPassword_Subtitle"]</p>

<form asp-action="ForgotPassword" method="post" novalidate>
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mb-4" role="alert">
            <div class="d-flex align-items-start gap-2">
                <i class="fa-solid fa-circle-exclamation flex-shrink-0 mt-1"></i>
                <div asp-validation-summary="All"></div>
            </div>
        </div>
    }

    <div class="mb-4">
        <label asp-for="Email" class="form-label">@Localizer["Common_Email"]</label>
        <div class="field-icon-wrap">
            <i class="fa-regular fa-envelope field-icon"></i>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="text-danger d-block mt-1" style="font-size:0.8125rem"></span>
    </div>

    <div class="d-grid mb-2">
        <button type="submit" class="btn btn-primary btn-sm">
            <span class="btn-text">
                @Localizer["ForgotPassword_SubmitButton"] &nbsp;<i class="fa-solid fa-paper-plane"></i>
            </span>
        </button>
    </div>

</form>

<div class="auth-footer-link">
    <a asp-action="Login" asp-controller="Account">
        <i class="fa-solid fa-arrow-left me-1"></i>@Localizer["ForgotPassword_BackToSignIn"]
    </a>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
