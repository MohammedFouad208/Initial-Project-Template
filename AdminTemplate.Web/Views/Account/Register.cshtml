@model AdminTemplate.Web.ViewModels.RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create Account";
}

<h2 class="auth-title">Create your account</h2>
<p class="auth-subtitle">Fill in the details below to get started</p>

<form asp-action="Register" method="post" novalidate>
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mb-4" role="alert">
            <div class="d-flex align-items-start gap-2">
                <i class="fa-solid fa-circle-exclamation flex-shrink-0 mt-1"></i>
                <div asp-validation-summary="All"></div>
            </div>
        </div>
    }

    <div class="mb-3">
        <label asp-for="FullName" class="form-label">Full name</label>
        <div class="field-icon-wrap">
            <i class="fa-regular fa-user field-icon"></i>
            <input asp-for="FullName" class="form-control" placeholder="John Doe" autocomplete="name" />
        </div>
        <span asp-validation-for="FullName" class="text-danger d-block mt-1" style="font-size:0.8125rem"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email address</label>
        <div class="field-icon-wrap">
            <i class="fa-regular fa-envelope field-icon"></i>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="text-danger d-block mt-1" style="font-size:0.8125rem"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Password</label>
        <div class="field-icon-wrap">
            <i class="fa-solid fa-lock field-icon"></i>
            <input asp-for="Password" class="form-control" placeholder="Min. 8 characters" autocomplete="new-password" />
        </div>
        <span asp-validation-for="Password" class="text-danger d-block mt-1" style="font-size:0.8125rem"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
        <div class="field-icon-wrap">
            <i class="fa-solid fa-lock field-icon"></i>
            <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat your password" autocomplete="new-password" />
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger d-block mt-1" style="font-size:0.8125rem"></span>
    </div>

    <div class="d-grid mb-2">
        <button type="submit" class="btn btn-primary btn-sm">
            <span class="btn-text">
                Create Account &nbsp;<i class="fa-solid fa-user-plus"></i>
            </span>
        </button>
    </div>

</form>

<div class="auth-footer-link">
    Already have an account?
    <a asp-action="Login" asp-controller="Account">Sign in</a>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
