@model AdminTemplate.Web.ViewModels.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<h2 class="auth-title">Set a new password</h2>
<p class="auth-subtitle">Choose a strong password for your account</p>

<form asp-action="ResetPassword" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input asp-for="Email" type="hidden" />
    <input asp-for="Token" type="hidden" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mb-4" role="alert">
            <div class="d-flex align-items-start gap-2">
                <i class="fa-solid fa-circle-exclamation flex-shrink-0 mt-1"></i>
                <div asp-validation-summary="All"></div>
            </div>
        </div>
    }

    <div class="mb-3">
        <label asp-for="Password" class="form-label">New password</label>
        <div class="field-icon-wrap">
            <i class="fa-solid fa-lock field-icon"></i>
            <input asp-for="Password" class="form-control" placeholder="Min. 8 characters" autocomplete="new-password" />
        </div>
        <span asp-validation-for="Password" class="text-danger d-block mt-1" style="font-size:0.8125rem"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label">Confirm new password</label>
        <div class="field-icon-wrap">
            <i class="fa-solid fa-lock field-icon"></i>
            <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat new password" autocomplete="new-password" />
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger d-block mt-1" style="font-size:0.8125rem"></span>
    </div>

    <div class="d-grid mb-2">
        <button type="submit" class="btn btn-primary btn-lg">
            <span class="btn-text">
                Reset Password &nbsp;<i class="fa-solid fa-shield-check"></i>
            </span>
        </button>
    </div>

</form>

<div class="auth-footer-link">
    <a asp-action="Login" asp-controller="Account">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Sign In
    </a>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
