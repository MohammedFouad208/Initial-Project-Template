@{
    Layout = "_AuthLayout";
}

<div class="text-center mb-3">
    <h2 class="auth-header">AdminTemplate</h2>
</div>

<div class="text-center">
    <i class="fas fa-envelope-open-text fa-3x mb-3" style="color: var(--primary-color);"></i>
    <h5 class="mb-2">Check Your Email</h5>
    <p class="text-muted">
        A password reset link has been sent. Please check your inbox (and spam folder).
    </p>
    <p class="text-muted small">
        In development, the link is printed to the application console output.
    </p>
</div>

<div class="d-grid mt-3">
    <a asp-action="Login" asp-controller="Account" class="btn btn-outline-secondary">Back to Sign In</a>
</div>
