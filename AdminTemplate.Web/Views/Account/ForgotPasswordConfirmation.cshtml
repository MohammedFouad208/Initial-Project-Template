@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Localizer["ForgotPasswordConfirmation_Title"];
}

<div class="text-center mb-4">
    <div style="width:5rem;height:5rem;background:var(--success-light);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:1.25rem">
        <i class="fa-solid fa-envelope-circle-check" style="font-size:2rem;color:var(--success)"></i>
    </div>
    <h2 class="auth-title">@Localizer["ForgotPasswordConfirmation_Heading"]</h2>
    <p class="auth-subtitle mb-0">@Localizer["ForgotPasswordConfirmation_Subtitle"]</p>
</div>

<div class="alert alert-success d-flex align-items-start gap-2 mb-4" role="note">
    <i class="fa-solid fa-circle-info flex-shrink-0 mt-1"></i>
    <span style="font-size:0.875rem">@Localizer["ForgotPasswordConfirmation_DevNote"]</span>
</div>

<div class="d-grid">
    <a asp-action="Login" asp-controller="Account" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left"></i> @Localizer["ForgotPasswordConfirmation_BackToSignIn"]
    </a>
</div>
