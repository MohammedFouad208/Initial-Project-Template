@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using System.Security.Claims
@{
    var appName = Configuration["App:Name"] ?? "Admin Template";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    string ActiveClass(string controllerName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;

    // Permission checks for sidebar visibility
    var sidebarUserIdStr = Context.User.FindFirstValue(ClaimTypes.NameIdentifier);
    Guid.TryParse(sidebarUserIdStr, out var sidebarUserId);
    var canBrowseUsers = sidebarUserId != Guid.Empty
        && await PermissionService.UserHasPermissionAsync(sidebarUserId, "User", "Browse");
    var canBrowseRoles = sidebarUserId != Guid.Empty
        && await PermissionService.UserHasPermissionAsync(sidebarUserId, "Role", "Browse");
}

<aside class="sidebar" id="adminSidebar" aria-label="Main navigation">
    <div class="sidebar-header">
        <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
            <span class="sidebar-brand-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </span>
            <span class="sidebar-brand-text">@appName</span>
        </a>
        <button class="sidebar-close-btn d-md-none" type="button" aria-label="Close sidebar">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <div class="offcanvas-body">
        <nav class="sidebar-nav">
            <div class="sidebar-nav-label">Main</div>

            <a asp-controller="Dashboard" asp-action="Index"
               class="nav-link @ActiveClass("Dashboard")"
               title="Dashboard">
                <span class="nav-icon"><i class="fa-solid fa-gauge-high"></i></span>
                <span class="nav-text">Dashboard</span>
            </a>

            <div class="sidebar-nav-label">Management</div>

            <a asp-controller="Users" asp-action="Index"
               class="nav-link @ActiveClass("Users") @(canBrowseUsers ? "" : "d-none")"
               title="Users">
                <span class="nav-icon"><i class="fa-solid fa-users"></i></span>
                <span class="nav-text">Users</span>
            </a>

            <a asp-controller="Roles" asp-action="Index"
               class="nav-link @ActiveClass("Roles") @(canBrowseRoles ? "" : "d-none")"
               title="Roles">
                <span class="nav-icon"><i class="fa-solid fa-shield-halved"></i></span>
                <span class="nav-text">Roles</span>
            </a>

            <a asp-controller="RolePermissions" asp-action="Index"
               class="nav-link @ActiveClass("RolePermissions")"
               title="Role Permissions">
                <span class="nav-icon"><i class="fa-solid fa-key"></i></span>
                <span class="nav-text">Role Permissions</span>
            </a>
        </nav>
    </div>
</aside>
