@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject AdminTemplate.Application.Providers.IObjectsProvider ObjectsProvider
@using System.Security.Claims
@{
    var appName = Configuration["App:Name"] ?? "Admin Template";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    string ActiveClass(string controllerName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;

    var sidebarUserIdStr = Context.User.FindFirstValue(ClaimTypes.NameIdentifier);
    Guid.TryParse(sidebarUserIdStr, out var sidebarUserId);
    var isSuperAdmin = Context.User.IsInRole("SuperAdmin");

    var objects = ObjectsProvider.GetAll();

    var canBrowseLkp = sidebarUserId != Guid.Empty
        && await PermissionService.UserHasPermissionAsync(sidebarUserId, "Lkp", "Browse");
}

<aside class="sidebar" id="adminSidebar" aria-label="Main navigation">
    <div class="sidebar-header">
        <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
            <span class="sidebar-brand-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </span>
            <span class="sidebar-brand-text">@appName</span>
        </a>
        <button class="sidebar-close-btn d-md-none" type="button" aria-label="Close sidebar">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <div class="offcanvas-body">
        <nav class="sidebar-nav">
            <div class="sidebar-nav-label">Main</div>

            <a asp-controller="Dashboard" asp-action="Index"
               class="nav-link @ActiveClass("Dashboard")"
               title="Dashboard">
                <span class="nav-icon"><i class="fa-solid fa-gauge-high"></i></span>
                <span class="nav-text">Dashboard</span>
            </a>

            <div class="sidebar-nav-label">Management</div>

            @foreach (var obj in objects)
            {
                var canBrowse = sidebarUserId != Guid.Empty
                    && await PermissionService.UserHasPermissionAsync(sidebarUserId, obj.Name, "Browse");

                <a asp-controller="@obj.Controller" asp-action="Index"
                   class="nav-link @ActiveClass(obj.Controller) @(canBrowse ? "" : "d-none")"
                   title="@obj.DisplayName">
                    <span class="nav-icon"><i class="@obj.Icon"></i></span>
                    <span class="nav-text">@obj.DisplayName</span>
                </a>
            }

            <a asp-controller="Lkp" asp-action="Index"
               class="nav-link @ActiveClass("Lkp") @(canBrowseLkp ? "" : "d-none")"
               title="Lookup Tables">
                <span class="nav-icon"><i class="fa-solid fa-list"></i></span>
                <span class="nav-text">Lookup Tables</span>
            </a>

            <a asp-controller="RolePermissions" asp-action="Index"
               class="nav-link @ActiveClass("RolePermissions")"
               title="Role Permissions">
                <span class="nav-icon"><i class="fa-solid fa-key"></i></span>
                <span class="nav-text">Role Permissions</span>
            </a>

            @if (isSuperAdmin)
            {
                <div class="sidebar-nav-label">Developer</div>

                <a asp-area="SystemAdmin" asp-controller="Home" asp-action="Index"
                   class="nav-link" title="System Admin">
                    <span class="nav-icon"><i class="fa-solid fa-code"></i></span>
                    <span class="nav-text">System Admin</span>
                </a>
            }
        </nav>
    </div>
</aside>
