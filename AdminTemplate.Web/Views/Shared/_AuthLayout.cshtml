@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - Admin Template" : "Admin Template")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* ---- Auth Layout ---- */
        .auth-wrapper {
            min-height: 100vh;
            display: flex;
        }

        /* Decorative left panel */
        .auth-panel {
            flex: 1;
            background: linear-gradient(145deg, #1e1b4b 0%, #4f46e5 55%, #7c3aed 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem 2.5rem;
            position: relative;
            overflow: hidden;
        }

        .auth-panel::before {
            content: '';
            position: absolute;
            width: 560px;
            height: 560px;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
            top: -180px;
            left: -180px;
        }

        .auth-panel::after {
            content: '';
            position: absolute;
            width: 380px;
            height: 380px;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
            bottom: -120px;
            right: -100px;
        }

        .auth-panel-content {
            position: relative;
            z-index: 1;
            color: white;
            text-align: center;
            max-width: 360px;
        }

        .auth-panel-logo {
            width: 68px;
            height: 68px;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.875rem;
            margin-bottom: 1.75rem;
            backdrop-filter: blur(8px);
        }

        .auth-panel h1 {
            font-size: 1.875rem;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 0.875rem;
        }

        .auth-panel p {
            color: rgba(255,255,255,0.72);
            font-size: 0.9375rem;
            line-height: 1.65;
            margin-bottom: 2rem;
        }

        .auth-features {
            list-style: none;
            padding: 0;
            margin: 0;
            text-align: start;
        }

        .auth-features li {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: rgba(255,255,255,0.85);
            font-size: 0.9rem;
            padding: 0.375rem 0;
        }

        .auth-features li .fa-circle-check {
            color: #6ee7b7;
            font-size: 1rem;
            flex-shrink: 0;
        }

        /* Form panel */
        .auth-form-panel {
            width: 480px;
            flex-shrink: 0;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            position: relative;
        }

        .auth-form-inner {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 3rem 2.5rem;
            max-width: 420px;
            width: 100%;
            margin: 0 auto;
        }

        .auth-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 0.375rem;
        }

        .auth-subtitle {
            color: #64748b;
            font-size: 0.9375rem;
            margin-bottom: 2rem;
        }

        /* Input with icon */
        .field-icon-wrap {
            position: relative;
        }

        .field-icon-wrap .form-control {
            padding-inline-start: 2.75rem;
        }

        .field-icon-wrap .field-icon {
            position: absolute;
            inset-inline-start: 0.875rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            pointer-events: none;
            font-size: 0.9375rem;
            z-index: 1;
        }

        /* Divider link row */
        .auth-footer-link {
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.875rem;
            color: #64748b;
        }

        .auth-footer-link a {
            color: #4f46e5;
            font-weight: 500;
            text-decoration: none;
        }

        .auth-footer-link a:hover { text-decoration: underline; }

        /* Direction toggle */
        .auth-dir-btn {
            position: absolute;
            top: 1.125rem;
            inset-inline-end: 1.125rem;
            height: 2rem;
            padding: 0 0.6rem;
            border-radius: 0.375rem;
            border: 1px solid #e2e8f0;
            background: transparent;
            cursor: pointer;
            font-size: 0.6875rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            color: #64748b;
            transition: background 150ms, color 150ms, border-color 150ms;
        }

        .auth-dir-btn:hover {
            background: #eef2ff;
            color: #4f46e5;
            border-color: #4f46e5;
        }

        /* Responsive */
        @@media (max-width: 991.98px) {
            .auth-form-panel { width: 420px; }
        }

        @@media (max-width: 767.98px) {
            .auth-panel { display: none; }
            .auth-form-panel { width: 100%; }
            .auth-form-inner { padding: 2rem 1.25rem; }
        }
    </style>
    <script>
        (function () {
            var d = localStorage.getItem("textDirection") || "ltr";
            document.documentElement.setAttribute("dir", d);
            document.documentElement.setAttribute("lang", d === "rtl" ? "ar" : "en");
        }());
    </script>
</head>
<body style="background:#f1f5f9">

    <div class="auth-wrapper">

        <!-- Decorative panel (hidden on mobile) -->
        <div class="auth-panel d-none d-md-flex">
            <div class="auth-panel-content">
                <div class="auth-panel-logo">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h1>Admin Template</h1>
                <p>A modern admin panel with role-based access control, user management, and full RTL support.</p>
                <ul class="auth-features">
                    <li><i class="fa-solid fa-circle-check"></i> Role-based permissions</li>
                    <li><i class="fa-solid fa-circle-check"></i> User &amp; role management</li>
                    <li><i class="fa-solid fa-circle-check"></i> RTL &amp; LTR support</li>
                    <li><i class="fa-solid fa-circle-check"></i> Fully responsive</li>
                </ul>
            </div>
        </div>

        <!-- Form panel -->
        <div class="auth-form-panel">
            <button class="auth-dir-btn" id="authDirBtn" type="button">RTL</button>
            <div class="auth-form-inner">
                @RenderBody()
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var btn = document.getElementById("authDirBtn");
            if (!btn) return;

            function updateBtn() {
                var dir = document.documentElement.getAttribute("dir") || "ltr";
                btn.textContent = dir === "rtl" ? "LTR" : "RTL";
                btn.title       = dir === "rtl" ? "Switch to Left-to-Right" : "Switch to Right-to-Left";
            }

            updateBtn();

            btn.addEventListener("click", function () {
                var current = document.documentElement.getAttribute("dir") || "ltr";
                var next   = current === "rtl" ? "ltr" : "rtl";
                document.documentElement.setAttribute("dir", next);
                document.documentElement.setAttribute("lang", next === "rtl" ? "ar" : "en");
                localStorage.setItem("textDirection", next);
                updateBtn();
            });
        }());

        // Form loading
        document.querySelectorAll("form").forEach(function (form) {
            form.addEventListener("submit", function () {
                var btn = form.querySelector('[type="submit"]');
                if (btn) {
                    btn.classList.add("btn-loading");
                    btn.disabled = true;
                }
            });
        });
    </script>
    @RenderSection("Scripts", required: false)

</body>
</html>
