@model AdminTemplate.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-3">
    <div>
        <h1 class="mb-1">Dashboard</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none" style="color:var(--primary)">Home</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-outline-secondary btn-sm">
            <i class="fa-regular fa-calendar"></i>
            <span>Last 30 days</span>
        </button>
        <button type="button" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-download"></i>
            <span class="d-none d-sm-inline">Export</span>
        </button>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="stat-card stat-primary">
            <div class="d-flex align-items-start justify-content-between mb-3">
                <div>
                    <p class="stat-label">Total Users</p>
                    <p class="stat-value" data-count="@Model.TotalUsers">@Model.TotalUsers</p>
                    <div class="stat-trend up">
                        <i class="fa-solid fa-arrow-trend-up"></i> +12% this month
                    </div>
                </div>
                <span class="stat-icon icon-primary">
                    <i class="fa-solid fa-users"></i>
                </span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card stat-success">
            <div class="d-flex align-items-start justify-content-between mb-3">
                <div>
                    <p class="stat-label">Active Users</p>
                    <p class="stat-value" data-count="@Model.ActiveUsers">@Model.ActiveUsers</p>
                    <div class="stat-trend up">
                        <i class="fa-solid fa-arrow-trend-up"></i> +5% this month
                    </div>
                </div>
                <span class="stat-icon icon-success">
                    <i class="fa-solid fa-user-check"></i>
                </span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card stat-warning">
            <div class="d-flex align-items-start justify-content-between mb-3">
                <div>
                    <p class="stat-label">Total Roles</p>
                    <p class="stat-value" data-count="@Model.TotalRoles">@Model.TotalRoles</p>
                    <div class="stat-trend flat">
                        <i class="fa-solid fa-minus"></i> No change
                    </div>
                </div>
                <span class="stat-icon icon-warning">
                    <i class="fa-solid fa-shield-halved"></i>
                </span>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="stat-card stat-info">
            <div class="d-flex align-items-start justify-content-between mb-3">
                <div>
                    <p class="stat-label">Inactive Users</p>
                    <p class="stat-value" data-count="@(Model.TotalUsers - Model.ActiveUsers)">@(Model.TotalUsers - Model.ActiveUsers)</p>
                    <div class="stat-trend down">
                        <i class="fa-solid fa-arrow-trend-down"></i> -3% this month
                    </div>
                </div>
                <span class="stat-icon icon-info">
                    <i class="fa-solid fa-user-xmark"></i>
                </span>
            </div>
        </div>
    </div>

</div>

<!-- Charts & Activity -->
<div class="row g-3 mb-3">

    <div class="col-xl-8">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                <span>User Registrations</span>
                <div class="d-flex gap-1">
                    <button type="button" class="btn btn-sm btn-primary">7D</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary">1M</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary">6M</button>
                </div>
            </div>
            <div class="card-body">
                <div style="height:220px;background:linear-gradient(180deg,var(--primary-light) 0%,rgba(238,242,255,0) 100%);border-radius:var(--border-radius);display:flex;align-items:center;justify-content:center;">
                    <div class="text-center" style="color:var(--text-muted)">
                        <i class="fa-solid fa-chart-line" style="font-size:2.25rem;opacity:0.25"></i>
                        <p class="mt-2 mb-0 small">Connect Chart.js or ApexCharts to render data here</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span>Recent Activity</span>
                <a href="#" style="font-size:0.8125rem;color:var(--primary);text-decoration:none">View all</a>
            </div>
            <div class="card-body" style="padding:0.875rem 1.25rem">

                <div class="activity-item">
                    <span class="activity-dot" style="background:var(--success)"></span>
                    <div>
                        <div class="activity-text">New user <strong>John Doe</strong> registered</div>
                        <div class="activity-time"><i class="fa-regular fa-clock me-1"></i>2 min ago</div>
                    </div>
                </div>

                <div class="activity-item">
                    <span class="activity-dot" style="background:var(--warning)"></span>
                    <div>
                        <div class="activity-text">Role <strong>Editor</strong> updated</div>
                        <div class="activity-time"><i class="fa-regular fa-clock me-1"></i>1 hr ago</div>
                    </div>
                </div>

                <div class="activity-item">
                    <span class="activity-dot" style="background:var(--primary)"></span>
                    <div>
                        <div class="activity-text">Permissions updated for <strong>Admin</strong></div>
                        <div class="activity-time"><i class="fa-regular fa-clock me-1"></i>3 hrs ago</div>
                    </div>
                </div>

                <div class="activity-item">
                    <span class="activity-dot" style="background:var(--danger)"></span>
                    <div>
                        <div class="activity-text">User <strong>Jane Smith</strong> deactivated</div>
                        <div class="activity-time"><i class="fa-regular fa-clock me-1"></i>Yesterday</div>
                    </div>
                </div>

                <div class="activity-item">
                    <span class="activity-dot" style="background:var(--info)"></span>
                    <div>
                        <div class="activity-text">New role <strong>Viewer</strong> created</div>
                        <div class="activity-time"><i class="fa-regular fa-clock me-1"></i>2 days ago</div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

<!-- Recent Users Table -->
<div class="row g-3">
    <div class="col-12">
        <div class="card table-card">
            <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                <span>Recent Users</span>
                <a asp-controller="Users" asp-action="Index" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-users"></i>
                    <span>Manage Users</span>
                </a>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:2rem;height:2rem;border-radius:50%;background:var(--primary-light);color:var(--primary);display:inline-flex;align-items:center;justify-content:center;font-size:0.6875rem;font-weight:700;flex-shrink:0">JD</div>
                                    <span style="font-weight:500">John Doe</span>
                                </div>
                            </td>
                            <td style="color:var(--text-secondary)">john@example.com</td>
                            <td><span class="badge-soft badge-soft-primary">Admin</span></td>
                            <td><span class="badge-soft badge-soft-success">Active</span></td>
                            <td class="text-end"><a href="#" style="color:var(--primary);font-size:0.875rem;text-decoration:none">View</a></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:2rem;height:2rem;border-radius:50%;background:#d1fae5;color:#065f46;display:inline-flex;align-items:center;justify-content:center;font-size:0.6875rem;font-weight:700;flex-shrink:0">JS</div>
                                    <span style="font-weight:500">Jane Smith</span>
                                </div>
                            </td>
                            <td style="color:var(--text-secondary)">jane@example.com</td>
                            <td><span class="badge-soft badge-soft-warning">Editor</span></td>
                            <td><span class="badge-soft badge-soft-danger">Inactive</span></td>
                            <td class="text-end"><a href="#" style="color:var(--primary);font-size:0.875rem;text-decoration:none">View</a></td>
                        </tr>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:2rem;height:2rem;border-radius:50%;background:#cffafe;color:#0e7490;display:inline-flex;align-items:center;justify-content:center;font-size:0.6875rem;font-weight:700;flex-shrink:0">MB</div>
                                    <span style="font-weight:500">Mike Brown</span>
                                </div>
                            </td>
                            <td style="color:var(--text-secondary)">mike@example.com</td>
                            <td><span class="badge-soft badge-soft-primary">Viewer</span></td>
                            <td><span class="badge-soft badge-soft-success">Active</span></td>
                            <td class="text-end"><a href="#" style="color:var(--primary);font-size:0.875rem;text-decoration:none">View</a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
