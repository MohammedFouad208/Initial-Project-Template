@{
    ViewData["Title"] = Localizer["Users_Index_Title"];
}

<div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-3">
    <div>
        <h1 class="mb-1">@Localizer["Users_Index_Title"]</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none breadcrumb-link">@Localizer["Common_Home"]</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">@Localizer["Users_Index_Title"]</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card table-card">
    <div class="card-body">
        <table id="usersTable" class="table table-hover w-100"></table>
    </div>
</div>

@Html.AntiForgeryToken()
<partial name="_DeleteConfirmModal" />

@section Scripts {
<script>
var _canUpdate = @Json.Serialize(ViewBag.CanUpdate);
var _canDelete = @Json.Serialize(ViewBag.CanDelete);
var usersTable;
usersTable = AppDataTable.init({
    tableId: 'usersTable',
    ajaxUrl: '@Url.Action("GetData", "Users")',
    columns: [
        { data: 'fullName', title: '@Localizer["Users_Column_Name"]',
            render: function (val, type, row) {
                if (type !== 'display') { return val || ''; }
                var initials = (val || '').split(' ').filter(function (w) { return w.length > 0; })
                    .map(function (w) { return w[0].toUpperCase(); }).slice(0, 2).join('');
                return '<div class="d-flex align-items-center gap-2">' +
                       '<span class="avatar-initials" aria-hidden="true">' + initials + '</span>' +
                       '<span>' + (val || '—') + '</span></div>';
            }
        },
        { data: 'email', title: '@Localizer["Common_Email"]' },
        { data: 'roles', title: '@Localizer["Common_Roles"]', orderable: false,
            render: function (val, type) {
                if (type !== 'display') { return val ? val.join(', ') : ''; }
                if (!val || val.length === 0) {
                    return '<span class="text-muted fst-italic">@Localizer["Users_Column_NoRoles"]</span>';
                }
                return val.map(function (r) {
                    return '<span class="badge badge-soft badge-soft-primary me-1">' + r + '</span>';
                }).join('');
            }
        },
        { data: 'isActive', title: '@Localizer["Common_Status"]',
            render: function (val, type, row) {
                if (type !== 'display') { return val ? '@Localizer["Common_Active"]' : '@Localizer["Common_Inactive"]'; }
                var badge = val
                    ? '<span class="badge badge-soft badge-soft-success dt-status-badge">@Localizer["Common_Active"]</span>'
                    : '<span class="badge badge-soft badge-soft-danger dt-status-badge">@Localizer["Common_Inactive"]</span>';
                if (_canUpdate) {
                    var btnClass = val ? 'btn-outline-danger' : 'btn-outline-success';
                    var btnIcon  = val ? 'fa-user-slash' : 'fa-user-check';
                    var btnTitle = val ? '@Localizer["Users_Label_Deactivate"]' : '@Localizer["Users_Label_Activate"]';
                    badge += '<button type="button" class="btn ' + btnClass + ' btn-sm dt-toggle-active ms-1" ' +
                        'data-id="' + row.id + '" data-active="' + val + '" title="' + btnTitle + '">' +
                        '<i class="fa-solid ' + btnIcon + '"></i></button>';
                }
                return badge;
            }
        },
        { data: 'createdAt', title: '@Localizer["Common_Created"]',
            render: function (val, type) {
                if (!val) { return '—'; }
                if (type !== 'display') { return val; }
                return new Date(val).toLocaleDateString();
            }
        },
        { data: null, title: '@Localizer["Common_Actions"]', orderable: false, searchable: false,
            render: function (data, type, row) {
                if (type !== 'display') { return ''; }
                var html = '<div class="d-flex gap-1">';
                if (_canUpdate) {
                    html += '<a href="@Url.Action("Edit", "Users")/' + row.id + '" class="btn btn-outline-secondary btn-sm" title="@Localizer["Common_Edit"]"><i class="fa-solid fa-pen-to-square"></i></a>';
                }
                if (_canDelete) {
                    html += '<button type="button" class="btn btn-outline-danger btn-sm dt-user-delete-btn" ' +
                            'data-delete-url="@Url.Action("Delete", "Users")/' + row.id + '" ' +
                            'data-record-label="' + (row.fullName || row.email || row.id) + '" title="@Localizer["Common_Delete"]">' +
                            '<i class="fa-solid fa-trash"></i></button>';
                }
                html += '</div>';
                return html;
            }
        }
    ],
    permissions: {
        canCreate: @Json.Serialize(ViewBag.CanCreate),
        canUpdate: false,
        canDelete: false
    },
    createUrl: '@Url.Action("Create", "Users")',
    objectName: 'User'
});

if (_canUpdate) {
$(document).on('click', '.dt-toggle-active', function () {
    var $btn     = $(this);
    var userId   = $btn.data('id');
    var isActive = $btn.data('active') === true || $btn.data('active') === 'true';
    var newState = !isActive;
    var token    = $('input[name="__RequestVerificationToken"]').val();
    if (!token) { console.warn('CSRF token missing'); return; }

    fetch('@Url.Action("ToggleActive", "Users")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
        body: 'id=' + encodeURIComponent(userId) + '&isActive=' + newState
    })
    .then(function (r) { return r.json(); })
    .then(function (res) {
        if (!res.success) { console.error('Toggle failed:', res.error); return; }
        var $row   = $btn.closest('tr');
        var $badge = $row.find('.dt-status-badge');
        if (newState) {
            $badge.removeClass('badge-soft-danger').addClass('badge-soft-success').text('@Localizer["Common_Active"]');
            $btn.data('active', true).removeClass('btn-outline-success').addClass('btn-outline-danger')
                .attr('title', '@Localizer["Users_Label_Deactivate"]').html('<i class="fa-solid fa-user-slash"></i>');
        } else {
            $badge.removeClass('badge-soft-success').addClass('badge-soft-danger').text('@Localizer["Common_Inactive"]');
            $btn.data('active', false).removeClass('btn-outline-danger').addClass('btn-outline-success')
                .attr('title', '@Localizer["Users_Label_Activate"]').html('<i class="fa-solid fa-user-check"></i>');
        }
    })
    .catch(function (e) { console.error('ToggleActive error:', e); });
});
}

$('#usersTable').on('click', '.dt-user-delete-btn', function () {
    var $btn      = $(this);
    var deleteUrl = $btn.data('delete-url');
    var label     = $btn.data('record-label');
    var $modal    = $('#deleteConfirmModal');
    var msgTpl    = '@Html.Raw(Localizer["Users_Label_DeleteConfirm"].Value.Replace("'", "\\'"))';
    $modal.find('#deleteConfirmBody').text(msgTpl.replace('{0}', label));
    $modal.find('.dt-delete-error').remove();
    $modal.find('#deleteConfirmBtn').data('delete-url', deleteUrl);
    bootstrap.Modal.getOrCreateInstance($modal[0]).show();
});

$(document).on('click', '#deleteConfirmBtn', function () {
    var deleteUrl = $(this).data('delete-url');
    var $modal    = $('#deleteConfirmModal');
    var token     = $('input[name="__RequestVerificationToken"]').val();
    if (!token) { console.warn('CSRF token missing'); return; }

    fetch(deleteUrl, { method: 'POST', headers: { 'RequestVerificationToken': token } })
    .then(function (res) { return res.json(); })
    .then(function (result) {
        if (result.success) {
            bootstrap.Modal.getOrCreateInstance($modal[0]).hide();
            usersTable.ajax.reload(null, false);
        } else {
            $modal.find('.dt-delete-error').remove();
            $modal.find('.modal-body').append(
                '<div class="alert alert-danger dt-delete-error mt-3 mb-0" style="border-inline-start:4px solid var(--danger)">' +
                '<i class="fa-solid fa-circle-exclamation me-2"></i>' +
                (result.message || '@Localizer["Users_Error_DeleteFailed"]') + '</div>');
        }
    })
    .catch(function () {
        $modal.find('.dt-delete-error').remove();
        $modal.find('.modal-body').append(
            '<div class="alert alert-danger dt-delete-error mt-3 mb-0" style="border-inline-start:4px solid var(--danger)">' +
            '@Localizer["Common_UnexpectedError"]</div>');
    });
});
</script>
}
