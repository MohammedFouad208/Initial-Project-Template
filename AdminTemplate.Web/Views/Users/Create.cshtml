@model AdminTemplate.Web.ViewModels.Users.CreateUserViewModel
@{
    ViewData["Title"] = Localizer["Users_Create_Title"];
}

<div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-3">
    <div>
        <h1 class="mb-1">@Localizer["Users_Create_Title"]</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none breadcrumb-link">@Localizer["Common_Home"]</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Users" asp-action="Index" class="text-decoration-none breadcrumb-link">@Localizer["Users_Index_Title"]</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">@Localizer["Common_Create"]</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger mb-4"
                 style="border-inline-start:4px solid var(--danger)"
                 role="alert">
            </div>
        }

        <form asp-action="Create" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <div class="field-icon-wrap">
                        <span class="field-icon"><i class="fa-solid fa-user"></i></span>
                        <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="field-icon-wrap">
                        <span class="field-icon"><i class="fa-solid fa-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="Enter email address" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="field-icon-wrap">
                        <span class="field-icon"><i class="fa-solid fa-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Min. 8 characters" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="field-icon-wrap">
                        <span class="field-icon"><i class="fa-solid fa-lock"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">@Localizer["Common_Roles"]</label>
                    <select id="rolesSelect" name="SelectedRoles" class="form-select" multiple
                            aria-label="Select one or more roles">
                        @foreach (var role in Model.AvailableRoles)
                        {
                            var selected = Model.SelectedRoles.Contains(role.Name) ? "selected" : null;
                            <option value="@role.Name" selected="@selected">@role.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-6 d-flex align-items-end pb-1">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">@Localizer["Common_Active"]</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-md">
                    <i class="fa-solid fa-floppy-disk me-1"></i>@Localizer["Users_Create_Title"]
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-md">@Localizer["Common_Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $('#rolesSelect').select2({ theme: 'bootstrap-5', placeholder: 'Select roles', allowClear: true, width: '100%' });
        });
    </script>
}
