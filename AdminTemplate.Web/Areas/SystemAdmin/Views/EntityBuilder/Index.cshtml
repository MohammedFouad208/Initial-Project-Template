@using AdminTemplate.Application.DTOs.CodeGen
@model IReadOnlyList<EntityDefinitionDto>
@{
    ViewData["Title"] = "Entity Builder";
}

<div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-3">
    <div>
        <h1 class="mb-1"><i class="fa-solid fa-database me-2 text-primary"></i>Entity Builder</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-area="SystemAdmin" asp-controller="Home" asp-action="Index"
                       class="text-decoration-none" style="color:var(--primary)">System Admin</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Entity Builder</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary" id="btnNewLkp">
            <i class="fa-solid fa-list me-1"></i>New Lkp Table
        </button>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i>New Entity
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert"
         style="border-inline-start:4px solid var(--success)">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card table-card">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-database fa-3x mb-3 opacity-25"></i>
                <p>No entities defined yet. <a asp-action="Create">Create the first one.</a></p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Table</th>
                            <th>Columns</th>
                            <th>Relations</th>
                            <th>Status</th>
                            <th>Generated At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entity in Model)
                        {
                            <tr>
                                <td><strong>@entity.Name</strong></td>
                                <td><code>@entity.TableName</code></td>
                                <td><span class="badge badge-soft badge-soft-primary">@entity.Columns.Count cols</span></td>
                                <td><span class="badge badge-soft badge-soft-primary">@entity.Relations.Count rels</span></td>
                                <td>
                                    @if (entity.IsGenerated)
                                    {
                                        <span class="badge bg-success">Generated</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>
                                <td>
                                    @(entity.GeneratedAt.HasValue
                                        ? entity.GeneratedAt.Value.ToString("yyyy-MM-dd HH:mm")
                                        : "—")
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <a asp-action="Details" asp-route-id="@entity.Id"
                                           class="btn btn-outline-primary btn-sm" title="Details">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        @if (!entity.IsGenerated)
                                        {
                                            <a asp-action="Edit" asp-route-id="@entity.Id"
                                               class="btn btn-outline-secondary btn-sm" title="Edit">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>
                                        }
                                        <button type="button"
                                                class="btn btn-success btn-sm btn-generate"
                                                data-id="@entity.Id"
                                                data-name="@entity.Name"
                                                title="Generate Code">
                                            <i class="fa-solid fa-bolt"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm btn-delete-entity"
                                                data-id="@entity.Id"
                                                data-name="@entity.Name"
                                                title="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@Html.AntiForgeryToken()

<!-- New Lkp modal -->
<div class="modal fade" id="newLkpModal" tabindex="-1" aria-labelledby="newLkpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="newLkpModalLabel">
                    <i class="fa-solid fa-list me-2 text-primary"></i>New Lookup Table
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Lookup Name <span class="text-danger">*</span></label>
                    <input type="text" id="lkpNameInput" class="form-control" placeholder="e.g. Country, Department…" />
                    <div class="form-text">PascalCase. The table will be created as <code>Lkp_<span id="lkpNamePreview">Name</span></code>.</div>
                    <div class="invalid-feedback">Name is required.</div>
                </div>
                <div class="alert alert-danger d-none" id="lkpCreateError"></div>
                <div class="alert alert-success d-none" id="lkpCreateSuccess"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="lkpCreateSaveBtn">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Create
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Generation result modal -->
<div class="modal fade" id="generateModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-bolt me-2"></i>Code Generation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="generateModalBody">
                <div class="text-center py-3">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Generating code...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete confirmation modal -->
<div class="modal fade" id="deleteEntityModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-trash me-2 text-danger"></i>Delete Entity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="deleteEntityBody">
                <p>Are you sure you want to delete <strong id="deleteEntityName"></strong>? This will drop the table and remove all generated files.</p>
            </div>
            <div class="modal-footer" id="deleteEntityFooter">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="deleteEntityConfirmBtn">
                    <i class="fa-solid fa-trash me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
var _token = $('input[name="__RequestVerificationToken"]:last').val();

// ── Lkp creation ────────────────────────────────────────────────────────────
$('#btnNewLkp').on('click', function () {
    $('#lkpNameInput').val('').removeClass('is-invalid');
    $('#lkpNamePreview').text('Name');
    $('#lkpCreateError, #lkpCreateSuccess').addClass('d-none').text('');
    bootstrap.Modal.getOrCreateInstance($('#newLkpModal')[0]).show();
});

$('#lkpNameInput').on('input', function () {
    var v = $(this).val().trim() || 'Name';
    $('#lkpNamePreview').text(v);
});

$('#lkpCreateSaveBtn').on('click', function () {
    var name = $('#lkpNameInput').val().trim();
    if (!name) { $('#lkpNameInput').addClass('is-invalid'); return; }
    $('#lkpNameInput').removeClass('is-invalid');
    $('#lkpCreateError, #lkpCreateSuccess').addClass('d-none').text('');

    var $btn = $(this).prop('disabled', true);
    fetch('@Url.Action("CreateLkp", "EntityBuilder", new { area = "SystemAdmin" })', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': _token },
        body: 'lkpName=' + encodeURIComponent(name)
    })
    .then(r => r.json())
    .then(res => {
        if (res.success) {
            $('#lkpCreateSuccess').removeClass('d-none').html('<i class="fa-solid fa-circle-check me-2"></i>' + res.message);
            $('#lkpNameInput').val('');
        } else {
            $('#lkpCreateError').removeClass('d-none').text(res.message || 'Error creating lookup table.');
        }
    })
    .catch(() => { $('#lkpCreateError').removeClass('d-none').text('Unexpected error.'); })
    .finally(() => { $btn.prop('disabled', false); });
});

// ── Entity deletion ─────────────────────────────────────────────────────────
var _deleteEntityId = null;

$(document).on('click', '.btn-delete-entity', function () {
    _deleteEntityId = $(this).data('id');
    var name = $(this).data('name');
    $('#deleteEntityName').text(name);
    $('#deleteEntityBody').html('<p>Are you sure you want to delete <strong>' + name + '</strong>? This will drop the table and remove all generated files.</p>');
    $('#deleteEntityFooter').html('<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>' +
        '<button type="button" class="btn btn-danger" id="deleteEntityConfirmBtn"><i class="fa-solid fa-trash me-1"></i>Delete</button>');
    bootstrap.Modal.getOrCreateInstance($('#deleteEntityModal')[0]).show();
});

$(document).on('click', '#deleteEntityConfirmBtn', function () {
    if (!_deleteEntityId) return;
    var $modal = $('#deleteEntityModal');
    var $body  = $('#deleteEntityBody');
    var $footer = $('#deleteEntityFooter');

    $body.html('<div class="text-center py-3"><div class="spinner-border text-danger" role="status"></div><p class="mt-2 text-muted">Deleting entity and all artifacts…</p></div>');
    $footer.html('<button type="button" class="btn btn-secondary" disabled>Cancel</button>');

    fetch('@Url.Action("Delete", "EntityBuilder", new { area = "SystemAdmin" })/' + _deleteEntityId, {
        method: 'POST',
        headers: { 'RequestVerificationToken': _token }
    })
    .then(r => r.json())
    .then(result => {
        if (result.success) {
            $body.html('<div class="alert alert-success mb-0"><i class="fa-solid fa-circle-check me-2"></i>' + result.message + '</div>' +
                       '<p class="text-muted small mt-2 mb-0">The page will reload automatically…</p>');
            $footer.html('');
            setTimeout(function () { location.reload(); }, 1500);
        } else {
            $body.html('<div class="alert alert-danger mb-0"><i class="fa-solid fa-circle-exclamation me-2"></i>' + (result.message || 'Delete failed.') + '</div>');
            $footer.html('<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>');
        }
    })
    .catch(function () {
        $body.html('<div class="alert alert-danger mb-0"><i class="fa-solid fa-circle-exclamation me-2"></i>An unexpected error occurred.</div>');
        $footer.html('<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>');
    });
});

$(document).on('click', '.btn-generate', function () {
    var id = $(this).data('id');
    var name = $(this).data('name');
    var $modal = $('#generateModal');
    var $body = $('#generateModalBody');

    $body.html('<div class="text-center py-3"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Generating <strong>' + name + '</strong>…</p></div>');
    bootstrap.Modal.getOrCreateInstance($modal[0]).show();

    fetch('@Url.Action("Generate", "EntityBuilder", new { area = "SystemAdmin" })/' + id, {
        method: 'POST',
        headers: { 'RequestVerificationToken': _token }
    })
    .then(r => r.json())
    .then(result => {
        if (result.success) {
            var fileList = (result.files || []).map(f => '<li class="text-monospace small">' + f + '</li>').join('');
            $body.html('<div class="alert alert-success"><i class="fa-solid fa-circle-check me-2"></i>' + result.message + '</div>' +
                       '<p class="fw-semibold mb-1">Generated files:</p><ul>' + fileList + '</ul>' +
                       '<p class="text-muted small mt-2">The page will reload automatically…</p>');
            setTimeout(function () { location.reload(); }, 2000);
        } else {
            $body.html('<div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i>' + (result.message || 'Generation failed.') + '</div>');
        }
    })
    .catch(() => {
        $body.html('<div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i>An unexpected error occurred.</div>');
    });
});
</script>
}
