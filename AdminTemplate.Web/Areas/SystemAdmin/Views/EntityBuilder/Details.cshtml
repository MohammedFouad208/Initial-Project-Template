@using AdminTemplate.Application.DTOs.CodeGen
@model EntityDefinitionDto
@{
    ViewData["Title"] = $"Entity: {Model.Name}";
}

<div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-3">
    <div>
        <h1 class="mb-1"><code>@Model.Name</code></h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-area="SystemAdmin" asp-controller="Home" asp-action="Index"
                       class="text-decoration-none" style="color:var(--primary)">System Admin</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-action="Index" class="text-decoration-none" style="color:var(--primary)">Entity Builder</a>
                </li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        @if (!Model.IsGenerated)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="fa-solid fa-pen-to-square me-1"></i>Edit
            </a>
        }
        <a asp-action="PreviewSql" asp-route-id="@Model.Id"
           class="btn btn-outline-info" target="_blank">
            <i class="fa-solid fa-code me-1"></i>Preview SQL
        </a>
        @if (!Model.IsGenerated)
        {
            <button type="button" class="btn btn-success btn-generate"
                    data-id="@Model.Id" data-name="@Model.Name">
                <i class="fa-solid fa-bolt me-1"></i>Generate
            </button>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         style="border-inline-start:4px solid var(--success)">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header fw-semibold">Entity Info</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Name</dt>
                    <dd class="col-7"><code>@Model.Name</code></dd>
                    <dt class="col-5">Table</dt>
                    <dd class="col-7"><code>@Model.TableName</code></dd>
                    <dt class="col-5">Description</dt>
                    <dd class="col-7">@(Model.Description ?? "—")</dd>
                    <dt class="col-5">Status</dt>
                    <dd class="col-7">
                        @if (Model.IsGenerated)
                        {
                            <span class="badge bg-success">Generated</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </dd>
                    @if (Model.GeneratedAt.HasValue)
                    {
                        <dt class="col-5">Generated At</dt>
                        <dd class="col-7">@Model.GeneratedAt.Value.ToString("yyyy-MM-dd HH:mm")</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header fw-semibold">
                <i class="fa-solid fa-columns me-2"></i>Columns (@Model.Columns.Count)
            </div>
            <div class="card-body p-0">
                @if (Model.Columns.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>MaxLen</th>
                                    <th>Required</th>
                                    <th>Unique</th>
                                    <th>In List</th>
                                    <th>In Form</th>
                                    <th title="Included in server-side search">Search</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var col in Model.Columns)
                                {
                                    <tr>
                                        <td class="text-muted small">@col.SortOrder</td>
                                        <td><code>@col.Name</code></td>
                                        <td><span class="badge badge-soft badge-soft-primary">@col.DataType</span></td>
                                        <td>@(col.MaxLength?.ToString() ?? "—")</td>
                                        <td>@(col.IsRequired ? "✓" : "—")</td>
                                        <td>@(col.IsUnique ? "✓" : "—")</td>
                                        <td>@(col.ShowInList ? "✓" : "—")</td>
                                        <td>@(col.ShowInForm ? "✓" : "—")</td>
                                        <td>@(col.UseInSearch ? "<span class=\"badge bg-info text-white\">✓</span>" : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-3 mb-0">No columns.</p>
                }
            </div>
        </div>

        @if (Model.Relations.Any())
        {
            <div class="card">
                <div class="card-header fw-semibold">
                    <i class="fa-solid fa-link me-2"></i>Relations (@Model.Relations.Count)
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Related Entity</th>
                                    <th>FK Column</th>
                                    <th>Navigation</th>
                                    <th>Display Col</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rel in Model.Relations)
                                {
                                    <tr>
                                        <td><code>@rel.RelatedEntityName</code></td>
                                        <td><code>@rel.ForeignKeyName</code></td>
                                        <td><code>@rel.NavigationPropertyName</code></td>
                                        <td>@rel.DisplayColumn</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@Html.AntiForgeryToken()

<!-- Generation result modal (shared with Index) -->
<div class="modal fade" id="generateModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-bolt me-2"></i>Code Generation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="generateModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
var _token = $('input[name="__RequestVerificationToken"]').val();

$(document).on('click', '.btn-generate', function () {
    var id = $(this).data('id');
    var name = $(this).data('name');
    var $modal = $('#generateModal');
    var $body = $('#generateModalBody');

    $body.html('<div class="text-center py-3"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted">Generating <strong>' + name + '</strong>…</p></div>');
    bootstrap.Modal.getOrCreateInstance($modal[0]).show();

    fetch('@Url.Action("Generate", "EntityBuilder", new { area = "SystemAdmin" })/' + id, {
        method: 'POST',
        headers: { 'RequestVerificationToken': _token }
    })
    .then(r => r.json())
    .then(result => {
        if (result.success) {
            var fileList = (result.files || []).map(f => '<li class="small font-monospace">' + f + '</li>').join('');
            $body.html('<div class="alert alert-success"><i class="fa-solid fa-circle-check me-2"></i>' + result.message + '</div>' +
                       '<p class="fw-semibold mb-1">Generated files:</p><ul>' + fileList + '</ul>' +
                       '<p class="text-muted small mt-2">The page will reload automatically…</p>');
            setTimeout(function () { location.reload(); }, 2000);
        } else {
            $body.html('<div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i>' + (result.message || 'Generation failed.') + '</div>');
        }
    })
    .catch(function () {
        $body.html('<div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i>An unexpected error occurred.</div>');
    });
});
</script>
}
