@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var appName = Configuration["App:Name"] ?? "Admin Template";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    string ActiveClass(string controllerName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
}

<aside class="sidebar" id="adminSidebar" aria-label="System Admin navigation">
    <div class="sidebar-header">
        <a asp-area="SystemAdmin" asp-controller="Home" asp-action="Index" class="sidebar-brand">
            <span class="sidebar-brand-icon">
                <i class="fa-solid fa-code"></i>
            </span>
            <span class="sidebar-brand-text">System Admin</span>
        </a>
        <button class="sidebar-close-btn d-md-none" type="button" aria-label="Close sidebar">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <div class="offcanvas-body d-flex flex-column">
        <nav class="sidebar-nav flex-grow-1">
            <div class="sidebar-nav-label">Overview</div>

            <a asp-area="SystemAdmin" asp-controller="Home" asp-action="Index"
               class="nav-link @ActiveClass("Home")" title="Dashboard">
                <span class="nav-icon"><i class="fa-solid fa-gauge-high"></i></span>
                <span class="nav-text">Dashboard</span>
            </a>

            <div class="sidebar-nav-label">Code Generator</div>

            <a asp-area="SystemAdmin" asp-controller="EntityBuilder" asp-action="Index"
               class="nav-link @ActiveClass("EntityBuilder")" title="Entity Builder">
                <span class="nav-icon"><i class="fa-solid fa-database"></i></span>
                <span class="nav-text">Entity Builder</span>
            </a>

            <div class="sidebar-nav-label">System</div>

            <a asp-area="SystemAdmin" asp-controller="Theme" asp-action="Index"
               class="nav-link @ActiveClass("Theme")" title="Theme Engine">
                <span class="nav-icon"><i class="fa-solid fa-palette"></i></span>
                <span class="nav-text">Theme Engine</span>
            </a>

            <a asp-area="SystemAdmin" asp-controller="Resources" asp-action="Index"
               class="nav-link @ActiveClass("Resources")" title="Resource Strings">
                <span class="nav-icon"><i class="fa-solid fa-language"></i></span>
                <span class="nav-text">Resource Strings</span>
            </a>

        </nav>

        <div class="mt-auto pt-3" style="border-top:1px solid var(--sidebar-border, rgba(255,255,255,.1))">
            <a href="/"
               class="nav-link d-flex align-items-center gap-2"
               style="color:var(--danger,#dc3545);opacity:.85"
               title="Exit System Admin">
                <span class="nav-icon"><i class="fa-solid fa-right-from-bracket"></i></span>
                <span class="nav-text">Exit System Admin</span>
            </a>
        </div>
    </div>
</aside>
